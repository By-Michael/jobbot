# ─── Telegram Bot ─────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ─── Telethon — User API (for scraping channels) ──────────────────────────────
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890

# ─── Gemini AI (PRIMARY — get key at aistudio.google.com) ─────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── OpenRouter AI (FALLBACK — free models, no credits needed) ────────────────
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-3-27b-it:free,qwen/qwen-2-7b-instruct:free

# ─── Telegram Channels to Scrape (numeric IDs) ────────────────────────────────
JOB_CHANNEL_IDS=-1001193582142,-1001197229252,-1001140766931

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=job_bot.db

# ─── Scraping Settings ────────────────────────────────────────────────────────
POSTS_PER_CHANNEL_SEARCH=100
POSTS_PER_CHANNEL_HOURLY=50

# ─── Scheduler ────────────────────────────────────────────────────────────────
HOURLY_SCRAPE_INTERVAL_MINUTES=60
EXPIRY_CHECK_INTERVAL_MINUTES=60

# ─── Pagination ───────────────────────────────────────────────────────────────
JOBS_PER_PAGE=10
